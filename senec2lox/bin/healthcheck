#!/usr/bin/php
<?php
/**
 * Healthcheck fuer die LoxBerry-Healthcheck-Seite ("Mein LoxBerry" > "Healthcheck").
 * Aufruf: "healthcheck title" (nur die Beschreibung) oder "healthcheck check" (Pruefung, Ausgabe als JSON).
 * Statuscodes: 3 Fehler (Benachrichtigung und E-Mail), 4 Warnung, 5 OK, 6 Info.
 * Der Dienst schreibt seinen Zustand regelmaessig nach /dev/shm/<Ordner>/status.json; hier wird nur gelesen.
 * Muss schnell sein und darf nichts anderes ausgeben als das JSON.
 */
date_default_timezone_set('Europe/Berlin');
$desc = 'Senec2Lox: Dienst, MQTT-Broker und SENEC-Abfrage';
$arg = $argv[1] ?? '';
if ($arg === 'title') {
    echo $desc, "\n";
    exit(0);
}
if ($arg !== 'check') {
    exit(0);
}

$dev = getenv('SENEC2LOX_DEV_DIR');
$run = getenv('SENEC2LOX_DEV_RUN') ?: ($dev ? $dev . '/run' : '/dev/shm/REPLACELBPPLUGINDIR');
$log = $dev ? $dev . '/senec2lox.log' : 'REPLACELBPLOGDIR/senec2lox.log';

function ergebnis(string $desc, int $status, string $text, string $log): void
{
    $o = ['desc' => $desc, 'status' => $status, 'result' => trim((string)preg_replace('/\s+/', ' ', $text))];
    if (is_file($log)) {
        $o['logfile'] = $log;           // nur mit echtem Wert, sonst fuehrt der Knopf ins Leere
    }
    echo json_encode($o, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
    exit(0);
}

$st = is_file("$run/status.json") ? json_decode((string)@file_get_contents("$run/status.json"), true) : null;
// Eine Dienstrunde kann bei langsamen Quellen (Zeitlimit bis 30 s) dauern: erst nach 2 Minuten ohne Statusmeldung gilt der Dienst als tot
if (!is_array($st) || time() - (int)($st['time'] ?? 0) > 120) {
    ergebnis($desc, 3, 'Der Dienst läuft nicht (keine aktuelle Statusmeldung). Der Wächter startet ihn spätestens nach einer Minute neu; sonst im Plugin den Reiter „Test“ und die Logdatei ansehen.', $log);
}
if (($st['service'] ?? '') === 'disabled') {
    ergebnis($desc, 6, 'Der Dienst ist in den Einstellungen abgeschaltet („Dienst aktiviert“).', $log);
}
if (empty($st['mqtt'])) {
    ergebnis($desc, 4, 'Keine Verbindung zum MQTT-Broker: ' . ($st['mqtt_error'] ?? 'unbekannt'), $log);
}
if (!empty($st['duplicates']) && is_array($st['duplicates'])) {
    ergebnis($desc, 4, 'Es läuft noch eine weitere Instanz (Plugin-Ordner: ' . implode(', ', $st['duplicates']) . '). Beide senden dieselben Topics; ein Plugin in der Plugin-Verwaltung deinstallieren.', $log);
}
$quellen = is_array($st['sources'] ?? null) ? $st['sources'] : [];
if (!$quellen) {
    ergebnis($desc, 6, 'Keine Datenquelle eingerichtet (Plugin öffnen, Reiter „Einstellungen“: lokal, OpenAPI oder SENEC.Connect).', $log);
}
$fehler = [];
foreach ($quellen as $name => $r) {
    if (empty($r['ok'])) {
        $text = (string)($r['error'] ?? '');
        $fehler[] = $name . ' (' . ($r['status'] ?? 'Fehler') . ($text !== '' ? ': ' . $text : '') . ')';
    }
}
if ($fehler) {
    ergebnis($desc, 4, 'Quelle ohne Antwort: ' . implode('; ', $fehler), $log);
}
$live = (string)($st['live_source'] ?? '');
ergebnis($desc, 5, count($quellen) . ' Quelle(n) in Ordnung' . ($live !== '' ? ', Live-Werte aus ' . $live : ''), $log);
